MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=readonly_user
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=example_database
MYSQL_MCP_MAX_LIMIT=500
MYSQL_MCP_QUERY_TIMEOUT_MS=10000
MYSQL_MCP_CONNECTION_LIMIT=5
# Optional: allow list/describe/sample tools to query schemas other than MYSQL_DATABASE.
MYSQL_MCP_ALLOW_SCHEMA_OVERRIDE=false
# Optional: write JSONL audit logs for executed tools and SQL. Query results are not logged.
MYSQL_MCP_LOG_FILE=
# Optional: put the variables above in another local file and expose only this path to your MCP client.
MYSQL_CONFIG_FILE=
